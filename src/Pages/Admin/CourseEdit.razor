@* CourseEdit.razor — admin form to edit an existing course *@
@page "/admin/courses/edit/{Id:int}"

<PageTitle>Edit Course — Admin</PageTitle>

<div class="page-container">
    @if (!Auth.IsAdmin)
    {
        <LoadingSpinner Label="Redirecting…" />
    }
    else if (_isLoading)
    {
        <LoadingSpinner />
    }
    else if (_model is null)
    {
        <p class="status-msg">Course not found.</p>
    }
    else
    {
        <header class="page-header">
            <div>
                <a href="/admin/courses" class="link-back">← Courses</a>
                <h1>Edit Course</h1>
            </div>
        </header>

        <AlertBox Message="@_error" Type="danger" />
        <AlertBox Message="@_success" Type="success" />

        <div class="form-card">
            <EditForm Model="_model" OnValidSubmit="HandleUpdate" novalidate>
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label>Title</label>
                    <InputText class="form-input" @bind-Value="_model.Title" />
                    <ValidationMessage For="@(() => _model.Title)" class="form-error-msg" />
                </div>

                <div class="form-group">
                    <label>Description</label>
                    <InputTextArea class="form-input form-textarea" @bind-Value="_model.Description" rows="3" />
                    <ValidationMessage For="@(() => _model.Description)" class="form-error-msg" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Category</label>
                        <InputSelect class="form-input" @bind-Value="_model.Category">
                            <option value="Fundamentals">Fundamentals</option>
                            <option value="Tools">Tools</option>
                            <option value="CTF">CTF</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => _model.Category)" class="form-error-msg" />
                    </div>

                    <div class="form-group">
                        <label>Difficulty</label>
                        <InputSelect class="form-input" @bind-Value="_model.Difficulty">
                            <option value="Beginner">Beginner</option>
                            <option value="Intermediate">Intermediate</option>
                            <option value="Advanced">Advanced</option>
                        </InputSelect>
                    </div>

                    <div class="form-group">
                        <label>Icon Emoji</label>
                        <InputText class="form-input" @bind-Value="_model.IconEmoji" />
                    </div>
                </div>

                <div class="form-group form-check">
                    <InputCheckbox @bind-Value="_model.IsPublished" id="published" />
                    <label for="published">Published</label>
                </div>

                <div class="form-actions">
                    <a href="/admin/courses" class="btn-secondary">Cancel</a>
                    <button type="submit" class="btn-primary" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Saving…" : "Save Changes")
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>
