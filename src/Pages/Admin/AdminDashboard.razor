@* AdminDashboard.razor — admin home panel *@
@page "/admin"


<PageTitle>Admin Panel — PwnLearn</PageTitle>


<div class="page-container">
    @if (!Auth.IsAdmin)
    {
        <LoadingSpinner Label="Redirecting…" />
    }
    else
    {
        <header class="page-header">
            <h1>Admin Panel</h1>
            <p class="page-subtitle">Manage courses, modules, and users.</p>
        </header>
        <div class="admin-nav-grid">
            <a href="/admin/courses" class="admin-nav-card">
                <span class="admin-nav-card__icon">📚</span>
                <div>
                    <h3>Courses</h3>
                    <p>Create, edit, and delete courses</p>
                </div>
            </a>
            <a href="/admin/users" class="admin-nav-card">
                <span class="admin-nav-card__icon">👥</span>
                <div>
                    <h3>Users</h3>
                    <p>View and manage registered members</p>
                </div>
            </a>
        </div>
    }
</div>
