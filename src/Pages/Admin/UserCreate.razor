@* UserCreate.razor — admin form to create a new user *@
@page "/admin/users/create"

<PageTitle>New User — Admin</PageTitle>

<div class="page-container">
    @if (!Auth.IsAdmin)
    {
        <LoadingSpinner Label="Redirecting…" />
    }
    else
    {
        <header class="page-header">
            <div>
                <a href="/admin/users" class="link-back">← Users</a>
                <h1>New User</h1>
            </div>
        </header>

        <AlertBox Message="@_error" Type="danger" />

        <div class="form-card">
            <EditForm Model="_model" FormName="admin-user-create" OnValidSubmit="HandleCreate" novalidate>
                <DataAnnotationsValidator />

                <div class="form-row">
                    <div class="form-group">
                        <label>Name</label>
                        <InputText class="form-input" @bind-Value="_model.Name" placeholder="Full name" />
                        <ValidationMessage For="@(() => _model.Name)" class="form-error-msg" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <InputText class="form-input" @bind-Value="_model.Email" placeholder="user@example.com" type="email" />
                        <ValidationMessage For="@(() => _model.Email)" class="form-error-msg" />
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Password</label>
                        <InputText class="form-input" @bind-Value="_model.Password" type="password" placeholder="Min. 8 characters" />
                        <ValidationMessage For="@(() => _model.Password)" class="form-error-msg" />
                    </div>

                    <div class="form-group">
                        <label>Role</label>
                        <InputSelect class="form-input" @bind-Value="_model.Role">
                            <option value="Member">Member</option>
                            <option value="Admin">Admin</option>
                        </InputSelect>
                    </div>
                </div>

                <div class="form-group form-check">
                    <InputCheckbox @bind-Value="_model.IsActive" id="isActive" />
                    <label for="isActive">Active (can log in)</label>
                </div>

                <div class="form-actions">
                    <a href="/admin/users" class="btn-secondary">Cancel</a>
                    <button type="submit" class="btn-primary" disabled="@_isSubmitting">
                        @(_isSubmitting ? "Creating…" : "Create User")
                    </button>
                </div>
            </EditForm>
        </div>
    }
</div>
