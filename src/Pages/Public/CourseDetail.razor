@* CourseDetail.razor — public preview of a single course *@
@page "/courses/{Id:int}"

@inject ICourseService CourseService
@inject NavigationManager Nav


<PageTitle>@(_course?.Title ?? "Course") — PwnLearn</PageTitle>


<div class="page-container">
    @if (_course is null)
    {
        <LoadingSpinner />
    }
    else
    {
        <div class="course-detail-header">
            <a href="/courses" class="link-back">← Back to Courses</a>
            <span class="course-icon-lg">@_course.IconEmoji</span>
            <h1>@_course.Title</h1>
            <div class="badge-row">
                <span class="badge badge-@_course.Difficulty.ToLower()">@_course.Difficulty</span>
                <span class="badge badge-category">@_course.Category</span>
                <span class="badge badge-outline">@_course.Modules.Count modules</span>
            </div>
            <p class="course-detail-desc">@_course.Description</p>
            <a href="/auth/register" class="btn-primary btn-lg">Register to Enroll</a>
        </div>
        <section class="section">
            <h2>What's Inside?</h2>
            <ol class="module-list">
                @foreach (var module in _course.Modules.OrderBy(m => m.OrderIndex))
                {
                    <li class="module-list__item">
                        <span class="module-list__num">@module.OrderIndex</span>
                        <span class="module-list__title">@module.Title</span>
                        @if (module.QuizQuestions.Count > 0)
                        {
                            <span class="badge badge-outline" style="font-size:0.75rem;">
                                @module.QuizQuestions.Count Q quiz
                            </span>
                        }
                    </li>
                }
            </ol>
        </section>
    }
</div>


@code {
    [Parameter] public int Id { get; set; }
    private Course? _course;

    protected override async Task OnInitializedAsync()
    {
        _course = await CourseService.GetWithModulesAsync(Id);
        if (_course is null) Nav.NavigateTo("/courses");
    }
}
